#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# The one authenticated Weston session. Started only by
# synveil-vt --authenticated-weston after veil-seat verified the owner
# credential; runs as the fixed UID/GID 1000 session identity. Closing
# both initial windows ends the session: this script exits, the seat
# lease drops, and the graphical login locks again. The compositor
# itself never locks (locking=false in weston.ini) because the seat
# lease, not an in-desktop screensaver, is the lock boundary.
PATH=/bin:/usr/bin
export PATH
export HOME=/home/synveil
export XDG_RUNTIME_DIR=/run/user/1000
export WAYLAND_DISPLAY=synveil-0
export LIBSEAT_BACKEND=seatd

if [ "$(id -u)" != 1000 ] || [ "$(id -g)" != 1000 ]; then
    echo "weston-session: refused unexpected session identity"
    exit 1
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "weston-session: runtime directory missing"
    exit 1
fi
cd "$HOME" || exit 1

SESSION_LOG="$HOME/weston-session.log"
mark() {
    echo "$1"
    echo "$1" >> "$SESSION_LOG"
}

rm -f "$HOME/weston.log" "$HOME/terminal.log" "$HOME/window.log"
weston --backend=drm-backend.so --renderer=pixman \
    --shell=desktop-shell.so --socket="$WAYLAND_DISPLAY" --idle-time=0 \
    --config=/etc/synveil/weston.ini --log="$HOME/weston.log" &
WESTON_PID=$!

attempts=0
while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do
    if ! kill -0 "$WESTON_PID" 2>/dev/null; then
        echo "weston-session: compositor exited before creating its socket"
        exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -gt 300 ]; then
        echo "weston-session: compositor socket timed out"
        kill "$WESTON_PID" 2>/dev/null
        exit 1
    fi
    sleep 0.1
done

weston-terminal >>"$HOME/terminal.log" 2>&1 &
TERMINAL_PID=$!
synveil-first-window --interactive >>"$HOME/window.log" 2>&1 &
WINDOW_PID=$!

attempts=0
while ! grep -q SYNVEIL_XDG_TOPLEVEL_SHM_SUBMITTED "$HOME/window.log" 2>/dev/null; do
    if ! kill -0 "$WINDOW_PID" 2>/dev/null || ! kill -0 "$WESTON_PID" 2>/dev/null; then
        echo "weston-session: first window failed to attach"
        kill "$TERMINAL_PID" "$WESTON_PID" 2>/dev/null
        exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -gt 300 ]; then
        echo "weston-session: first window attach timed out"
        kill "$TERMINAL_PID" "$WINDOW_PID" "$WESTON_PID" 2>/dev/null
        exit 1
    fi
    sleep 0.1
done
sleep 1
if ! kill -0 "$TERMINAL_PID" 2>/dev/null || ! kill -0 "$WESTON_PID" 2>/dev/null; then
    echo "weston-session: terminal or compositor died during startup"
    kill "$WINDOW_PID" "$WESTON_PID" 2>/dev/null
    exit 1
fi
mark SYNVEIL_WESTON_SESSION_TWO_WINDOWS_READY

# The graphical update controls (owner Priority 2) exist only on
# A/B generations: the ab-system marker gates the launch, so this
# same script on a single-image system never starts the GUI. The
# GUI is auxiliary — the session neither waits on it to end nor
# ends with it; it is reaped before the compositor at logout. Its
# agent only answers once a booted trial's health assessment has
# finished, so readiness is awaited with a long bound and a timeout
# degrades to a session-log note, never a failed session.
GUI_PID=""
if [ -f /etc/synveil/ab-system ] && [ -x /usr/bin/synveil-update-gui ]; then
    # The GUI log is cumulative across sessions: an update flow
    # spans a reboot (stage in one session, confirm in the next),
    # and the log is the flow's evidence. Readiness below must
    # therefore only consider lines written by THIS launch — a
    # previous session's READY proves nothing about this one — so
    # the greps run on the tail past the pre-launch byte offset.
    GUI_LOG_OFFSET=0
    if [ -f "$HOME/update-gui.log" ]; then
        GUI_LOG_OFFSET=$(stat -c%s "$HOME/update-gui.log" 2>/dev/null || echo 0)
    fi
    synveil-update-gui >>"$HOME/update-gui.log" 2>&1 &
    GUI_PID=$!
    gui_ready() {
        tail -c +$((GUI_LOG_OFFSET + 1)) "$HOME/update-gui.log" 2>/dev/null \
            | grep -q SYNVEIL_UPDATE_GUI_READY
    }
    attempts=0
    while ! gui_ready; do
        if ! kill -0 "$GUI_PID" 2>/dev/null; then
            echo "weston-session: update GUI exited before becoming ready"
            GUI_PID=""
            break
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -gt 1200 ]; then
            echo "weston-session: update GUI readiness timed out"
            break
        fi
        sleep 0.1
    done
    if [ -n "$GUI_PID" ] && gui_ready; then
        mark SYNVEIL_WESTON_SESSION_UPDATE_GUI_READY
    fi
fi

# The graphical file-access window (owner Priority 4) exists only
# where the files-app marker is set (A/B generations): an auxiliary
# read-only listing of Downloads and home, launched and reaped
# exactly like the update GUI. Its per-entry log is cumulative for
# the same reason the GUI log is: a download in one session is
# looked for in the next.
FILES_PID=""
if [ -f /etc/synveil/files-app ] && [ -x /usr/bin/synveil-files ]; then
    FILES_LOG_OFFSET=0
    if [ -f "$HOME/files-window.log" ]; then
        FILES_LOG_OFFSET=$(stat -c%s "$HOME/files-window.log" 2>/dev/null || echo 0)
    fi
    synveil-files >>"$HOME/files-window.log" 2>&1 &
    FILES_PID=$!
    files_ready() {
        tail -c +$((FILES_LOG_OFFSET + 1)) "$HOME/files-window.log" 2>/dev/null \
            | grep -q SYNVEIL_FILES_WINDOW_READY
    }
    attempts=0
    while ! files_ready; do
        if ! kill -0 "$FILES_PID" 2>/dev/null; then
            echo "weston-session: files window exited before becoming ready"
            FILES_PID=""
            break
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -gt 600 ]; then
            echo "weston-session: files window readiness timed out"
            break
        fi
        sleep 0.1
    done
    if [ -n "$FILES_PID" ] && files_ready; then
        mark SYNVEIL_WESTON_SESSION_FILES_READY
    fi
fi

# The graphical browser (owner Priority 3) exists only where the
# browser marker is set (A/B generations with the browser stage
# installed). The wrapper prepares the profile's Downloads
# directory, pins the Wayland backend and execs NetSurf; the
# session only notes that it started — page loads are the
# browser's own business and are evidenced by the network, not by
# a session marker claiming more than it saw.
BROWSER_PID=""
if [ -f /etc/synveil/browser ] && [ -x /usr/bin/synveil-browser ]; then
    BROWSER_LOG_OFFSET=0
    if [ -f "$HOME/browser.log" ]; then
        BROWSER_LOG_OFFSET=$(stat -c%s "$HOME/browser.log" 2>/dev/null || echo 0)
    fi
    synveil-browser >>"$HOME/browser.log" 2>&1 &
    BROWSER_PID=$!
    browser_started() {
        tail -c +$((BROWSER_LOG_OFFSET + 1)) "$HOME/browser.log" 2>/dev/null \
            | grep -q SYNVEIL_BROWSER_STARTED
    }
    attempts=0
    while ! browser_started; do
        if ! kill -0 "$BROWSER_PID" 2>/dev/null; then
            echo "weston-session: browser exited before starting"
            BROWSER_PID=""
            break
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -gt 600 ]; then
            echo "weston-session: browser start timed out"
            break
        fi
        sleep 0.1
    done
    if [ -n "$BROWSER_PID" ] && browser_started; then
        mark SYNVEIL_WESTON_SESSION_BROWSER_STARTED
    fi
fi

# The first window closes on Escape (real keyboard input through the
# compositor). Its exit is the keyboard proof; the terminal must still
# be usable afterwards.
wait "$WINDOW_PID"
if ! kill -0 "$TERMINAL_PID" 2>/dev/null || ! kill -0 "$WESTON_PID" 2>/dev/null; then
    echo "weston-session: desktop did not survive the window close"
    kill "$WESTON_PID" 2>/dev/null
    exit 1
fi
mark SYNVEIL_WESTON_SESSION_KEYBOARD_CLOSE_OK

# The terminal exits when its shell receives "exit" (real keyboard
# input). With both initial windows closed the session is over.
wait "$TERMINAL_PID"
if ! kill -0 "$WESTON_PID" 2>/dev/null; then
    echo "weston-session: compositor died before the terminal closed"
    exit 1
fi
mark SYNVEIL_WESTON_SESSION_TERMINAL_INPUT_OK

if [ -n "$GUI_PID" ]; then
    kill "$GUI_PID" 2>/dev/null
fi
if [ -n "$FILES_PID" ]; then
    kill "$FILES_PID" 2>/dev/null
fi
if [ -n "$BROWSER_PID" ]; then
    kill "$BROWSER_PID" 2>/dev/null
fi
kill "$WESTON_PID" 2>/dev/null
wait "$WESTON_PID" 2>/dev/null
mark SYNVEIL_WESTON_SESSION_LOGOUT
exit 0
