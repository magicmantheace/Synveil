#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
# Development GUI supervisor; recovery console remains separately available.
desktop="${SYNVEIL_DESKTOP_BINARY:-/usr/bin/synveil-display}"
pause="${SYNVEIL_DESKTOP_RETRY_DELAY:-1}"
case "$pause" in
    0|1) ;;
    *) echo "[synveil-desktop] invalid retry delay" >&2; exit 2 ;;
esac
if [ ! -x "$desktop" ]; then
    printf '\nSYNVEIL_DESKTOP_UNAVAILABLE\n'
    exit 1
fi
attempt=1
while [ "$attempt" -le 3 ]; do
    "$desktop" --menu
    status=$?
    if [ "$status" -eq 0 ]; then
        printf '\nSYNVEIL_DESKTOP_EXITED\n'
        exit 0
    fi
    if [ "$attempt" -ge 3 ]; then
        printf '\nSYNVEIL_DESKTOP_RESTART_EXHAUSTED\n'
        exit 1
    fi
    printf '\nSYNVEIL_DESKTOP_RESTARTING\n'
    attempt=$((attempt + 1))
    sleep "$pause"
done
exit 1
