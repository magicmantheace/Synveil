# Synveil Phase 1 QEMU/UEFI bootstrap kernel fragment

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-synveil"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_INET=y

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_PSI=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y

CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE_OVERRIDE=y

# Keep early bring-up simple.
# CONFIG_MODULES is not set
